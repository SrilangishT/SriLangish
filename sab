local function updateESP()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = p.Character.HumanoidRootPart
			local billboard = hrp:FindFirstChild("SrilangishESP")
			
			if espEnabled then
				if not billboard then
					billboard = Instance.new("BillboardGui")
					billboard.Name = "SrilangishESP"
					billboard.Size = UDim2.new(0, 100, 0, 40)
					billboard.AlwaysOnTop = true
					billboard.StudsOffset = Vector3.new(0, 3, 0)
					
					local textLabel = Instance.new("TextLabel")
					textLabel.Size = UDim2.new(1, 0, 1, 0)
					textLabel.BackgroundTransparency = 1
					textLabel.Font = Enum.Font.GothamBold
					textLabel.TextSize = 12
					textLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
					textLabel.TextStrokeTransparency = 0.5
					textLabel.Parent = billboard
					
					billboard.Parent = hrp
				end
				billboard.TextLabel.Text = p.Name
				billboard.Enabled = true
			else
				if billboard then
					billboard:Destroy()
				end
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	if espEnabled then
		updateESP()
	end
	
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		local humanoid = char:FindFirstChild("Humanoid")
		lastPosition = hrp.Position
		
		-- Speed CFrame 0.5
		if speedCFrameEnabled then
			hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * 0.5)
		end
		
		-- Float to Camera Position Logic
		if floatToCamEnabled then
			local cam = Workspace.CurrentCamera
			if cam then
				hrp.CFrame = cam.CFrame
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
		-- Velocity Float Logic (Keeps animations active + smooth upward movement on jump)
		elseif velocityFloatEnabled then
			local targetY = 0
			if humanoid and humanoid.Jump then
				targetY = 16 -- Smooth upward ascent when jumping
			end
			local vel = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, targetY, vel.Z)
		end
	end
end)

-- Character respawn capture position tracking
player.CharacterAdded:Connect(function(char)
	char:WaitForChild("HumanoidRootPart")
	task.wait(0.5)
	lastPosition = char.HumanoidRootPart.Position
end)

-- Tween to Base Function
local function tweenToBase()
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
		local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(basePosition)})
		tween:Play()
	end
end

